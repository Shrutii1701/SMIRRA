PORT=5000
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB connection string (MongoDB Atlas or a local mongod instance).
# Example (Atlas): mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/smirra
# Example (local): mongodb://127.0.0.1:27017/smirra
# If left blank, the app still runs but accounts/history are not persisted.
MONGODB_URI=your_mongodb_connection_string_here

# Secret used to sign login tokens (JWT). Use a long random string in production.
JWT_SECRET=change_this_to_a_long_random_secret
